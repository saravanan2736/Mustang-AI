{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "ai.mustang.desktop.probe",
  "build": {
    "frontendDist": "../desktop-prototypes/connectivity-probe/ui",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mustang AI — Phase B Connectivity Probe",
        "width": 1100,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#07090E"
      }
    ],
    "security": {
      "capabilities": ["main", "probe"]
    }
  }
}
