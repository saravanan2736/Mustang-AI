{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mustang AI",
  "version": "0.1.0",
  "identifier": "ai.mustang.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mustang AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#07090E"
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Mustang AI",
    "copyright": "Copyright © 2026 Mustang AI",
    "category": "Productivity",
    "shortDescription": "Local-first AI chat with open-weight models on your own GPU",
    "longDescription": "Mustang AI runs open-weight language models locally with NVIDIA CUDA acceleration. No accounts, no cloud services required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Mustang AI",
        "installerHooks": "windows/installer-hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
